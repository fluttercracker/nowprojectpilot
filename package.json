{
  "name": "projectpilot",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://fluttercracker.github.io/nowprojectpilot",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run copy-api && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "api": "json-server api/db.json --port 4000",
    "copy-api": "node -e \"const fs=require('fs');fs.mkdirSync('public/api',{recursive:true});fs.copyFileSync('api/db.json','public/api/db.json');\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.11",
    "bootstrap": "^5.3.8",
    "json-server": "^0.16.2",
    "mini.css": "^3.0.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.0",
    "react-bootstrap": "^2.10.10",
    "react-content-loader": "^7.1.1",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.6",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
